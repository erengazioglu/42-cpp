CC		= c++ -Wall -Wextra -Werror -std=c++98
NAME 	= mutant
SRC		= \
	main.cpp
DEP		= \
	MutantStack.hpp

all: $(NAME)

$(NAME): $(SRC) $(DEP)
	$(CC) $(SRC) -o $(NAME)

clean:
	@echo "Nothing to clean"
fclean:
	rm -f $(NAME)
re: fclean all
.PHONY: all clean fclean re
