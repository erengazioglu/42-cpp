CC		= c++ -Wall -Wextra -Werror -std=c++98
NAME 	= bsp
SRC		= Fixed.cpp Point.cpp bsp.cpp main.cpp
DEP		= Fixed.hpp

all: $(NAME)

$(NAME): $(SRC) $(DEP)
	$(CC) $(SRC) -o $(NAME)

clean:
	@echo "Nothing to clean"
fclean:
	rm $(NAME)
re: fclean all
.PHONY: all clean fclean re