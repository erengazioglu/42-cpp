CC		= c++ -Wall -Wextra -Werror -std=c++98
NAME 	= phonebook
SRC		= classes.cpp main.cpp print.cpp helpers.cpp
DEP		= phonebook.hpp

all: $(NAME)

$(NAME): $(SRC) $(DEP)
	$(CC) $(SRC) -o $(NAME)

clean:
	@echo "Nothing to clean"
fclean:
	rm $(NAME)
re: fclean all
.PHONY: all clean fclean re